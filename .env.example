# Copy to `.env.local`
ADMIN_SECRET=change-me-to-a-long-random-string

# Supabase — каталог, лиды, кабинеты (после `supabase db push` и `npm run seed:catalog`)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Только для Supabase CLI (link / db push) — Dashboard → Account → Access Tokens
SUPABASE_ACCESS_TOKEN=

# Пароль БД (Settings → Database) — для CI: GitHub → repo → Settings → Secrets → Actions → SUPABASE_DB_PASSWORD
# SUPABASE_DB_PASSWORD=

# Опционально: ref проекта (20 символов), если не делали `npm run db:link`
# SUPABASE_PROJECT_ID=

# GitHub Actions (Secrets): SUPABASE_ACCESS_TOKEN, SUPABASE_DB_PASSWORD; опционально SUPABASE_PROJECT_REF.
# Для ручного seed в workflow: NEXT_PUBLIC_SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY.

# Marketplace (phases 0-5)
# NEXT_PUBLIC_SHOW_PROJECT_REC=false
# ANALYTICS_INGEST_SECRET=
# STRIPE_WEBHOOK_SECRET=


# Security / lead pipeline (see docs/SECURITY.md)
# ADMIN_SECRET must be >= 16 chars in production
# NEXT_PUBLIC_SITE_URL=https://your-domain
# NEXT_PUBLIC_LEGAL_ENTITY=
# NEXT_PUBLIC_LEGAL_EMAIL=
# Cloudflare Turnstile (captcha on the lead form; both keys or neither)
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
# Lead notification email via Resend
# RESEND_API_KEY=
# NOTIFY_FROM=OFFPLAN <leads@your-domain>
# LEAD_NOTIFY_EMAIL=sales@your-domain
